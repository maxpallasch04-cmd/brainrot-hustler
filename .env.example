# BrainrotHustler — Hosting-Zugänge (Cloudflare R2).
# Diese Datei als `.env` ins Repo-Root kopieren und ausfüllen.
# `.env` ist gitignored und wird von `hosting` automatisch geladen.

# --- Pflicht ---------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Aufräumen (optional) --------------------------------------------------
# Nach jedem Upload: nur die neuesten R2_KEEP Objekte bleiben, Gesamtgröße < R2_QUOTA_GB.
# R2_KEEP=1
# R2_QUOTA_GB=10

# --- weiteres (optional) ---------------------------------------------------
# R2_ENDPOINT=
# R2_PREFIX=videos/
