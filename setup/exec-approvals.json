{
  "version": 1,
  "agents": {
    "brainrothustler": {
      "security": "allowlist",
      "ask": "on-miss",
      "askFallback": "deny",
      "allowlist": [
        {
          "pattern": "~/.openclaw/workspace-brainrothustler/bin/cli",
          "argPattern": "^(editor|hosting|longterm_memory|yt_clips)\\.cli( \\S+)*$"
        }
      ]
    }
  }
}
