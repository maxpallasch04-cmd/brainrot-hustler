#!/usr/bin/env bash
# cli - BrainrotHustler Modul-Wrapper
#
# Aktiviert die Workspace-venv und ruft ein Modul-CLI auf. Arbeitsverzeichnis
# ist der **Workspace-Root**: relative Pfade beziehen sich damit auf
# memory/videos, memory/clips, memory/screenshots, memory/brainrot.db.
# `modules/` liegt nur noch auf dem PYTHONPATH (dort ist der Code).
#
# Die Exec-Policy bindet nur dieses Skript (kein `source`-Operand, kein
# Interpreter-Pfad als erstes Token).
#
# Nutzung (aus beliebigem cwd):
#   ~/.openclaw/workspace-brainrothustler/bin/cli <modul.cli> [args...]
# Beispiel:
#   ~/.openclaw/workspace-brainrothustler/bin/cli yt_clips.cli next
#   ~/.openclaw/workspace-brainrothustler/bin/cli editor.cli probe --in memory/videos/out.mp4
#
set -euo pipefail

# Wurzel = Elternverzeichnis dieses Skripts (bin/ -> Workspace-Root).
# Nicht `~` in Quotes: das expandiert bash dort nicht.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$ROOT/.venv"
MODULES="$ROOT/modules"

# shellcheck disable=SC1091
source "$VENV/bin/activate"
export PYTHONPATH="$MODULES${PYTHONPATH:+:$PYTHONPATH}"
cd "$ROOT"

if [ "$#" -eq 0 ]; then
  echo "usage: cli <modul.cli> [args...]" >&2
  echo "module: editor.cli hosting.cli longterm_memory.cli yt_clips.cli" >&2
  exit 2
fi

exec python3 -m "$@"
