#!/usr/bin/env bash
# cli - BrainrotHustler Wrapper für KANAL-FREIE Aufrufe
#
# Aktiviert die venv, setzt modules/ auf den PYTHONPATH, arbeitet im
# Workspace-Root. Es wird KEIN Kanal gesetzt - kanalgebundene Module
# (longterm_memory-Daten, yt_clips) verweigern den Start ohne Kanal.
#
# Hierher gehören:
#   editor.cli ...                     (reine Funktion: Spec -> mp4)
#   hosting.cli ...                    (Prefix kommt aus dem Profil, wenn eindeutig)
#   longterm_memory.cli channel-list
#   longterm_memory.cli channel-get <id>
#   longterm_memory.cli channel-set <id> ...
#
# Kanalgebunden: ../channel <id> <modul.cli> [args...]
#
# Nutzung:
#   ~/.openclaw/workspace-brainrothustler/bin/cli editor.cli probe --in memory/videos/x.mp4
#
set -euo pipefail

# Wurzel = Elternverzeichnis dieses Skripts (bin/ -> Workspace-Root).
# Nicht `~` in Quotes: das expandiert bash dort nicht.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$ROOT/.venv"
MODULES="$ROOT/modules"

# shellcheck disable=SC1091
source "$VENV/bin/activate"
export PYTHONPATH="$MODULES${PYTHONPATH:+:$PYTHONPATH}"
cd "$ROOT"

if [ "$#" -eq 0 ]; then
  echo "usage: cli <modul.cli> [args...]" >&2
  echo "  kanal-frei: editor.cli, longterm_memory.cli task|channel-*" >&2
  echo "  kanalgebunden: benutze ../channel <id> <modul.cli> [args...]" >&2
  exit 2
fi

exec python3 -m "$@"
